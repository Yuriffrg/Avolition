#!/bin/sh
# Test shim for the renderer tests (WHITEHOUND_TEST_PYTHON): "app.py ..." runs the
# Go core with the same arguments, anything else runs python3.
# OWIO_CORE_BIN selects the Go binary (default: gocore/bin/owio-core).
here=$(cd "$(dirname "$0")" && pwd)
case "$1" in
  */app.py|app.py)
    shift
    AVOLITION_WEB_ROOT="${AVOLITION_WEB_ROOT:-$here/../../web}" exec "${OWIO_CORE_BIN:-$here/../bin/owio-core}" "$@" ;;
esac
exec python3 "$@"
